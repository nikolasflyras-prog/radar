<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Spinout Radar — Weekly Digest</title><style>
:root{--ink:#101820;--muted:#5e6b75;--line:#dce3e7;--paper:#f7f8f6;--card:#fff;--red:#b3261e;--amber:#9a6700;--green:#137333;--purple:#6f42c1;--blue:#0b57d0}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.55 ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif}.wrap{max-width:1040px;margin:auto;padding:42px 24px 80px}header{border-bottom:3px solid var(--ink);padding-bottom:18px;margin-bottom:30px}h1{font-size:36px;letter-spacing:-1px;margin:0}h2{font-size:20px;margin:40px 0 14px;border-bottom:1px solid var(--line);padding-bottom:8px}h3{margin:0;font-size:18px}.meta,.muted{color:var(--muted)}.card{background:var(--card);border:1px solid var(--line);border-left:5px solid var(--amber);padding:18px;margin:12px 0}.urgent{border-left-color:var(--red)}.emerging{border-left-color:var(--green)}.industry{border-left-color:var(--purple)}.score{float:right;font:700 22px ui-monospace,monospace}a{color:var(--blue)}ul{padding-left:22px}.health{width:100%;border-collapse:collapse;background:#fff}.health th,.health td{text-align:left;vertical-align:top;padding:10px;border-bottom:1px solid var(--line)}code{background:#edf0f2;padding:2px 5px;border-radius:4px}.pill{font-size:12px;color:var(--muted);border:1px solid var(--line);border-radius:12px;padding:1px 6px}.healthy{color:var(--green);font-weight:700}.partial{color:var(--amber);font-weight:700}.unavailable{color:var(--red);font-weight:700}@media(max-width:650px){.wrap{padding:25px 14px}.score{float:none;display:block;margin-bottom:6px}.health{font-size:13px}}
</style></head><body><main class="wrap"><header><h1>Spinout Radar</h1><div class="meta">Weekly public-signal digest · {{ generated.strftime('%Y-%m-%d %H:%M UTC') }}</div></header>
{% for heading,items,klass in [('1. Investigate now',top,'urgent'),('2. Watching',watching,''),('3. Emerging entity leads',emerging,'emerging')] %}<h2>{{ heading }}</h2>{% if not items %}<p class="muted">No entity currently qualifies.</p>{% endif %}{% for item in items %}<article class="card {{ klass }}"><span class="score">{{ '%.1f'|format(item.score) }}</span><h3>{{ item.canonical_name }}</h3><p>{{ item.explanation }}</p><ul>{% for s in details[item.id] %}<li>{% if s.url %}<a href="{{ s.url }}">{{ s.title }}</a>{% else %}{{ s.title }}{% endif %} — {{ s.summary }}</li>{% endfor %}</ul></article>{% endfor %}{% endfor %}
<h2>4. Spinout discovery inbox</h2><p class="muted">Formation, founder-movement, and stealth signals not yet tied confidently to a scored entity.</p>{% for x in spinout_inbox %}<article class="card emerging"><span class="score">{{ '%.1f'|format(x.score) }}</span><span class="pill">{{ x.source }}</span> <h3>{% if x.url %}<a href="{{ x.url }}">{{ x.title }}</a>{% else %}{{ x.title }}{% endif %}</h3><p>{{ x.reason }}</p></article>{% else %}<p class="muted">No qualifying spinout signals.</p>{% endfor %}
<h2>5. Industry intelligence</h2><p class="muted">Technical and market context without company-formation evidence. These are not spinout alerts.</p>{% for x in industry_intelligence %}<article class="card industry"><span class="score">{{ '%.1f'|format(x.score) }}</span><span class="pill">{{ x.source }}</span> <h3>{% if x.url %}<a href="{{ x.url }}">{{ x.title }}</a>{% else %}{{ x.title }}{% endif %}</h3><p>{{ x.reason }}</p></article>{% else %}<p class="muted">No qualifying industry items.</p>{% endfor %}
<h2>6. Watchlist people mentioned publicly</h2><ul>{% for x in watchlist_mentions %}<li><strong>{{ x.person }}</strong> — {% if x.url %}<a href="{{ x.url }}">{{ x.title }}</a>{% else %}{{ x.title }}{% endif %} <span class="muted">{{ x.source }} · {{ x.signal_type }}</span></li>{% else %}<li>No watchlist people mentioned this week.</li>{% endfor %}</ul>
<h2>7. GitHub identity candidates</h2><p class="muted">Verify manually before adding any handle to the watchlist.</p><ul>{% for x in github_candidates %}<li><strong>{{ x.person }} → @{{ x.username }}</strong> — confidence {{ x.confidence }}/10; {{ x.reasons|join('; ') }}. {% if x.url %}<a href="{{ x.url }}">Profile</a>{% endif %}<br><code>radar confirm-github "{{ x.person }}" {{ x.username }}</code></li>{% else %}<li>No new GitHub identity candidates.</li>{% endfor %}</ul>
<h2>8. New relevant entities this week</h2><ul>{% for x in new_entities %}<li>{{ x.canonical_name }} — {{ x.tier }}, {{ '%.1f'|format(x.score) }}, first seen {{ x.first_seen[:10] }}</li>{% else %}<li>None.</li>{% endfor %}</ul>
<h2>9. Cluster watch</h2><ul>{% for x in clusters %}<li><strong>{{ x.canonical_name }}</strong> — {{ x.people_count }} people: {{ x.people }}; {{ x.signal_count }} signals across {{ x.source_count }} sources</li>{% else %}<li>No corroborated multi-person clusters.</li>{% endfor %}</ul>
<h2>10. Signal-driven LinkedIn checks</h2><p class="muted">Human review only. Spinout Radar never accesses LinkedIn.</p><ul>{% for x in signal_review %}<li>☐ <strong>{{ x.canonical_name }}</strong> — {{ x.reason }}<br><code>radar note person "{{ x.canonical_name }}" "observation"</code></li>{% else %}<li>No signal-driven profiles this week.</li>{% endfor %}</ul>
<h2>11. Routine founder rotation</h2><ul>{% for x in routine_review %}<li>☐ <strong>{{ x.canonical_name }}</strong> — {{ x.reason }}<br><code>radar note person "{{ x.canonical_name }}" "observation"</code></li>{% else %}<li>No routine profiles selected.</li>{% endfor %}</ul>
<h2>12. Possible entity merges</h2><ul>{% for x in merges %}<li>{{ x.left_name }} ↔ {{ x.right_name }} ({{ '%.0f'|format(x.similarity) }}%)</li>{% else %}<li>None.</li>{% endfor %}</ul>
<h2>13. Source health</h2><table class="health"><thead><tr><th>Source</th><th>Status</th><th>Rows</th><th>New</th><th>Errors</th></tr></thead><tbody>{% for x in health %}<tr><td>{{ x.source }}</td><td class="{{ x.status|lower }}">{{ x.status }}</td><td>{{ x.rows_fetched }}</td><td>{{ x.new_signals }}</td><td>{% for error in x.errors[:2] %}{{ error }}<br>{% endfor %}{% if x.errors|length > 2 %}+{{ x.errors|length - 2 }} more{% elif not x.errors %}—{% endif %}</td></tr>{% else %}<tr><td colspan="5">No runs recorded.</td></tr>{% endfor %}</tbody></table></main></body></html>
