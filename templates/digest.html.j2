<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Spinout Radar — Weekly Digest</title><style>
:root{--ink:#101820;--muted:#5e6b75;--line:#dce3e7;--paper:#f7f8f6;--card:#fff;--red:#b3261e;--amber:#9a6700;--blue:#0b57d0}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.55 ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif}.wrap{max-width:980px;margin:auto;padding:48px 24px 80px}header{border-bottom:3px solid var(--ink);padding-bottom:20px;margin-bottom:32px}h1{font-size:36px;letter-spacing:-1px;margin:0}h2{font-size:20px;margin:42px 0 16px;border-bottom:1px solid var(--line);padding-bottom:8px}h3{margin:0;font-size:19px}.meta,.muted{color:var(--muted)}.card{background:var(--card);border:1px solid var(--line);border-left:5px solid var(--amber);padding:20px;margin:12px 0}.urgent{border-left-color:var(--red)}.score{float:right;font:700 24px ui-monospace,monospace}a{color:var(--blue)}ul{padding-left:22px}.health{width:100%;border-collapse:collapse;background:#fff}.health th,.health td{text-align:left;padding:10px;border-bottom:1px solid var(--line)}code{background:#edf0f2;padding:2px 5px;border-radius:4px}@media(max-width:600px){.wrap{padding:28px 16px}.score{float:none;display:block;margin-bottom:8px}}
</style></head><body><main class="wrap"><header><h1>Spinout Radar</h1><div class="meta">Weekly public-signal digest · {{ generated.strftime('%Y-%m-%d %H:%M UTC') }}</div></header>
<h2>1. Top alerts</h2>{% set top = leaderboard|selectattr('tier','equalto','Investigate now')|list %}{% if not top %}<p class="muted">No entity crossed the investigate-now threshold.</p>{% endif %}{% for item in top %}<article class="card urgent"><span class="score">{{ '%.1f'|format(item.score) }}</span><h3>{{ item.canonical_name }}</h3><p>{{ item.explanation }}</p><ul>{% for s in details[item.id] %}<li>{% if s.url %}<a href="{{ s.url }}">{{ s.title }}</a>{% else %}{{ s.title }}{% endif %} — {{ s.summary }}</li>{% endfor %}</ul><strong>Next action:</strong> Review people, patents, filing, and domain; seek a warm-path introduction.</article>{% endfor %}
<h2>2. New this week</h2><ul>{% for x in new_items %}<li>{{ x.canonical_name }} — {{ x.first_seen[:10] }}</li>{% else %}<li>None.</li>{% endfor %}</ul>
<h2>3. Cluster watch</h2><ul>{% for x in edges %}<li>{{ x.a }} ↔ {{ x.b }} <span class="muted">{{ x.edge_type }}</span></li>{% else %}<li>No recent connected-person edges.</li>{% endfor %}</ul>
<h2>4. Manual LinkedIn review sheet</h2><p class="muted">Human review only. Spinout Radar never accesses LinkedIn.</p><ul>{% for x in manual %}<li>☐ <strong>{{ x.canonical_name }}</strong> — {{ x.reasons }}. Look for title/company change.<br><code>radar note person "{{ x.canonical_name }}" "observation"</code></li>{% else %}<li>No profiles prioritized.</li>{% endfor %}</ul>
<h2>5. Possible entity merges</h2><ul>{% for x in merges %}<li>{{ x.left_name }} ↔ {{ x.right_name }} ({{ '%.0f'|format(x.similarity) }}%)</li>{% else %}<li>None.</li>{% endfor %}</ul>
<h2>6. Source health</h2><table class="health"><thead><tr><th>Source</th><th>Rows</th><th>New</th><th>Errors</th></tr></thead><tbody>{% for x in health %}<tr><td>{{ x.source }}</td><td>{{ x.rows_fetched }}</td><td>{{ x.new_signals }}</td><td>{{ x.errors_json }}</td></tr>{% else %}<tr><td colspan="4">No runs recorded.</td></tr>{% endfor %}</tbody></table></main></body></html>

