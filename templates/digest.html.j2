<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Spinout Radar — Weekly Digest</title><style>
:root{--ink:#101820;--muted:#5e6b75;--line:#dce3e7;--paper:#f7f8f6;--card:#fff;--red:#b3261e;--amber:#9a6700;--blue:#0b57d0;--green:#16794b;--purple:#6f42c1}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.55 ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif}.wrap{max-width:1040px;margin:auto;padding:48px 24px 80px}header{border-bottom:3px solid var(--ink);padding-bottom:20px;margin-bottom:32px}h1{font-size:36px;letter-spacing:-1px;margin:0}h2{font-size:20px;margin:42px 0 16px;border-bottom:1px solid var(--line);padding-bottom:8px}h3{margin:0;font-size:19px}.meta,.muted{color:var(--muted)}.card{background:var(--card);border:1px solid var(--line);border-left:5px solid var(--blue);padding:20px;margin:12px 0}.urgent{border-left-color:var(--red)}.watching{border-left-color:var(--amber)}.discovery{border-left-color:var(--green)}.score{float:right;font:700 24px ui-monospace,monospace}.pill{font-size:12px;border:1px solid var(--line);border-radius:999px;padding:2px 8px;color:var(--muted)}a{color:var(--blue)}ul{padding-left:22px}.inbox{display:grid;gap:10px}.inbox-item{background:#fff;border:1px solid var(--line);padding:14px 16px}.spinout-item{border-left:4px solid var(--green)}.industry-item{border-left:4px solid var(--purple)}.health{width:100%;border-collapse:collapse;background:#fff}.health th,.health td{text-align:left;padding:10px;border-bottom:1px solid var(--line);vertical-align:top}.Healthy{color:var(--green);font-weight:700}.Partial{color:var(--amber);font-weight:700}.Unavailable{color:var(--red);font-weight:700}code{background:#edf0f2;padding:2px 5px;border-radius:4px}@media(max-width:600px){.wrap{padding:28px 16px}.score{float:none;display:block;margin-bottom:8px}}
</style></head><body><main class="wrap"><header><h1>Spinout Radar</h1><div class="meta">Weekly public-signal digest · {{ generated.strftime('%Y-%m-%d %H:%M UTC') }}</div></header>
{% macro entity_cards(items, cls, empty_text) -%}{% if not items %}<p class="muted">{{ empty_text }}</p>{% endif %}{% for item in items %}<article class="card {{ cls }}"><span class="score">{{ '%.1f'|format(item.score) }}</span><h3>{{ item.canonical_name }}</h3><p>{{ item.explanation }}</p><ul>{% for s in details[item.id] %}<li><span class="pill">{{ s.source }}</span> {% if s.url %}<a href="{{ s.url }}">{{ s.title }}</a>{% else %}{{ s.title }}{% endif %} — {{ s.summary }}</li>{% endfor %}</ul></article>{% endfor %}{%- endmacro %}
<h2>1. Investigate now</h2>{{ entity_cards(top,'urgent','No entity crossed the investigate-now threshold.') }}
<h2>2. Watching</h2>{{ entity_cards(watching,'watching','No entity currently scores in the watching tier.') }}
<h2>3. Emerging entity leads</h2>{{ entity_cards(emerging,'discovery','No named entities currently meet the discovery threshold.') }}
<h2>4. Spinout discovery inbox</h2><p class="muted">Formation, founder-movement, and stealth signals not yet tied confidently to a scored entity.</p><div class="inbox">{% for x in spinout_inbox %}<div class="inbox-item spinout-item"><strong>{{ '%.1f'|format(x.score) }}</strong> <span class="pill">{{ x.source }}</span> {% if x.url %}<a href="{{ x.url }}"><strong>{{ x.title }}</strong></a>{% else %}<strong>{{ x.title }}</strong>{% endif %}<div class="muted">{{ x.reason }}{% if x.people %} · people: {{ x.people }}{% endif %}</div></div>{% else %}<p class="muted">No qualifying spinout signals.</p>{% endfor %}</div>
<h2>5. Industry intelligence</h2><p class="muted">Relevant technical and market context without company-formation evidence. These are not spinout alerts.</p><div class="inbox">{% for x in industry_intelligence %}<div class="inbox-item industry-item"><strong>{{ '%.1f'|format(x.score) }}</strong> <span class="pill">{{ x.source }}</span> {% if x.url %}<a href="{{ x.url }}"><strong>{{ x.title }}</strong></a>{% else %}<strong>{{ x.title }}</strong>{% endif %}<div class="muted">{{ x.reason }}</div></div>{% else %}<p class="muted">No qualifying industry items.</p>{% endfor %}</div>
<h2>6. New relevant entities this week</h2><ul>{% for x in new_entities %}<li><strong>{{ x.canonical_name }}</strong> — {{ x.tier }}, {{ '%.1f'|format(x.score) }}, first seen {{ x.first_seen[:10] }}</li>{% else %}<li>None.</li>{% endfor %}</ul>
<h2>7. Cluster watch</h2><ul>{% for x in clusters %}<li><strong>{{ x.canonical_name }}</strong> — {{ x.people_count }} people: {{ x.people }}; {{ x.signal_count }} signals across {{ x.source_count }} sources</li>{% else %}<li>No corroborated multi-person clusters.</li>{% endfor %}</ul>
<h2>8. Signal-driven LinkedIn checks</h2><p class="muted">Human review only. Every name below has a recent public signal.</p><ul>{% for x in signal_review %}<li>☐ <strong>{{ x.canonical_name }}</strong> — {{ x.reason }}.<br><code>radar note person "{{ x.canonical_name }}" "observation"</code></li>{% else %}<li>No signal-driven profiles this week.</li>{% endfor %}</ul>
<h2>9. Routine founder rotation</h2><p class="muted">Fallback checks, clearly separated from actual alerts.</p><ul>{% for x in routine_review %}<li>☐ <strong>{{ x.canonical_name }}</strong> — {{ x.reason }}.<br><code>radar note person "{{ x.canonical_name }}" "observation"</code></li>{% else %}<li>No routine profiles selected.</li>{% endfor %}</ul>
<h2>10. Possible entity merges</h2><ul>{% for x in merges %}<li>{{ x.left_name }} ↔ {{ x.right_name }} ({{ '%.0f'|format(x.similarity) }}%)</li>{% else %}<li>None.</li>{% endfor %}</ul>
<h2>11. Source health</h2><table class="health"><thead><tr><th>Source</th><th>Status</th><th>Rows</th><th>New</th><th>Errors</th></tr></thead><tbody>{% for x in health %}<tr><td>{{ x.source }}</td><td class="{{ x.status }}">{{ x.status }}</td><td>{{ x.rows_fetched }}</td><td>{{ x.new_signals }}</td><td>{% if x.errors %}{{ x.errors[0] }}{% if x.errors|length > 1 %}<br><span class="muted">+{{ x.errors|length - 1 }} more</span>{% endif %}{% else %}—{% endif %}</td></tr>{% else %}<tr><td colspan="5">No runs recorded.</td></tr>{% endfor %}</tbody></table></main></body></html>
